# RepoDive 환경변수 예시.
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋되지 않는다.
#   cp .env.example .env
# 모든 항목은 생략 가능하며, 생략하면 아래 적힌 기본값이 쓰인다.
# (ANTHROPIC_API_KEY 만 예외 — 없으면 /analyze 가 503을 반환한다.)


# ── 필수 ────────────────────────────────────────────────────

# Claude API 키. 없으면 요약 생성이 503으로 실패한다. 기본값: (없음)
ANTHROPIC_API_KEY=


# ── 선택 ────────────────────────────────────────────────────

# GitHub 개인 액세스 토큰. 없으면 GitHub API 한도가 시간당 60회로 낮다(있으면 5,000회).
# public repo만 읽으므로 스코프 없는 토큰이면 충분하다. 기본값: (없음)
GITHUB_TOKEN=

# PostgreSQL 접속 문자열. docker-compose.yml 의 기본 계정에 맞춰져 있다.
#   docker compose up -d   로 띄우고 앱을 기동하면 테이블이 자동 생성된다.
# 비워 두면 DB 없이 동작한다 — 요약 캐시가 꺼져 매번 LLM을 호출하고,
# 대화 기능(/chat)은 503을 반환한다. 기본값: (없음)
DATABASE_URL=postgresql://repodive:repodive@localhost:5432/repodive

# CORS 로 허용할 프론트엔드 주소. Vite 개발 서버 기본 포트에 맞춰져 있다.
# 기본값: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# 분석을 거부할 저장소 크기 상한(KB, GitHub의 size 필드 기준). 0이면 제한 없음.
# size는 git 히스토리까지 포함한 값이라 LLM에 보내는 양과는 거의 무관하다
# (react 1.0GB, TypeScript 2.9GB). 낮게 잡으면 정상 저장소가 거절되므로 기본은 꺼둔다.
# 기본값: 0
MAX_REPO_SIZE_KB=0


# ── RAG (코드 검색) ──────────────────────────────────────────
#
# 대화에서 실제 소스 코드를 근거로 답하기 위한 설정. 임베딩은 로컬 ONNX 모델이라
# API 호출도 과금도 없다. 인덱싱은 저장소마다 한 번, /analyze 직후 백그라운드로 돈다
# (큰 저장소는 수십 분이 걸린다 — 진행 상황은 GET /chat/{id}/index 로 볼 수 있다).
#
# ※ vector 확장이 필요하다. docker-compose.yml 이 pgvector/pgvector:pg17 을 쓰는 이유다.
#   공식 postgres 이미지로 바꾸면 code_chunks 생성이 실패하고 코드 검색만 꺼진다.

# 임베딩 모델. 기본값은 코드 특화 모델(30개 언어)이며 최초 1회 655MB를 내려받는다.
# 바꾸면 EMBEDDING_DIM 과 schema.sql 의 vector(N) 도 함께 고치고 재인덱싱해야 한다.
# 기본값: jinaai/jina-embeddings-v2-base-code
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

# 임베딩 차원. schema.sql 의 vector(768) 과 반드시 같아야 한다. 기본값: 768
EMBEDDING_DIM=768

# fastembed 목록에 없는 모델을 등록할 때만 쓰는 둘. 목록에 있는 모델이면 무시된다.
# EMBEDDING_MODEL 은 **우리가 붙이는 이름**이고, 가중치를 어디서 어떤 파일로 받을지는
# 이 둘이 정한다. 이름을 나눈 이유는 같은 저장소의 다른 파일(양자화 등)을 쓸 때
# 이름까지 같으면 청킹 규칙 해시가 그대로라 옛 인덱스와 조용히 섞이기 때문이다.
#   예) 같은 모델의 int8 양자화 (2,132MB → 536MB)
#       EMBEDDING_MODEL=intfloat/multilingual-e5-large-int8
#       EMBEDDING_SOURCE_REPO=intfloat/multilingual-e5-large
#       EMBEDDING_MODEL_FILE=onnx/model_qint8_avx512_vnni.onnx
# 기본값: (EMBEDDING_MODEL 과 같음) / onnx/model.onnx
EMBEDDING_SOURCE_REPO=
EMBEDDING_MODEL_FILE=onnx/model.onnx

# 모델 가중치를 둘 폴더. 비워 두면 Back/cache/models 를 쓴다.
# OS 임시 폴더에 두면 윈도우가 청소할 때 655MB를 다시 받게 된다.
# 기본값: Back/cache/models
EMBEDDING_CACHE_DIR=

# 임베딩 접두어. **모델에 따라 필수다.**
# E5 계열(intfloat/multilingual-e5-*)은 질의에 "query: ", 문서에 "passage: " 를 붙이지
# 않으면 검색 품질이 크게 떨어진다. fastembed 는 이걸 자동으로 붙여주지 않는다.
# jina-embeddings-v2-base-code 는 접두어가 필요 없으므로 비워 둔다.
# 기본값: (둘 다 없음)
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=

# 청크를 넣을 테이블. pgvector 의 vector(N) 은 차원이 고정이라 차원이 다른 모델을
# 한 테이블에 담을 수 없다. 모델을 바꿔 비교하려면 차원에 맞는 테이블을 지정한다.
#   code_chunks      = 768  (jinaai/jina-embeddings-v2-base-code)
#   code_chunks_1024 = 1024 (intfloat/multilingual-e5-large)
# 기본값: code_chunks
CHUNK_TABLE=code_chunks

# 다국어(한국어) 모델로 바꾸려면 위 넷을 이렇게 바꾼다:
#   EMBEDDING_MODEL=intfloat/multilingual-e5-large
#   EMBEDDING_DIM=1024
#   EMBEDDING_QUERY_PREFIX="query: "
#   EMBEDDING_PASSAGE_PREFIX="passage: "
#   CHUNK_TABLE=code_chunks_1024
# ※ 접두어는 **반드시 따옴표로 감싼다.** 코드가 접두어 뒤에 공백을 넣지 않으므로
#   값에 공백이 포함돼야 하는데, 따옴표가 없으면 .env 파서가 끝 공백을 잘라
#   "query:비밀번호..." 처럼 붙어버린다.
# 기존 code_chunks(768) 데이터는 그대로 남으므로 언제든 되돌릴 수 있다.
# 모델별 검색 품질 비교는 /admin/search 에서 본다.

# 인덱싱 상한. 0이면 해당 제한 없음.
# 소스는 tarball 한 번으로 받으므로 GitHub 요청 수가 아니라 크기가 비용이다.
# tarball 에는 이미지·3D 모델 같은 비소스 파일도 들어 있어 실제 인덱싱 부담과
# 비례하지 않는다. 낮게 잡으면 정상 저장소의 코드 검색이 통째로 막힌다
# (80MB 였을 때 3D 에셋이 든 저장소가 여기 걸렸다).
# 기본값: 524288000(500MB) / 204800(200KB) / 3000
MAX_ARCHIVE_BYTES=524288000
MAX_SOURCE_FILE_BYTES=204800
MAX_SOURCE_FILES=3000

# 스냅샷에 보관할 소스 원문의 크기 상한(바이트). 0이면 제한 없음.
# 위 두 값이 3,000 × 200KB 라 이론상 600MB 까지 가능하다. 넘으면 그 스냅샷은
# 한 행도 보관하지 않는다 — 자르면 "저장소에 없다"와 "잘려서 없다"를
# 구분할 수 없어진다. 기본값: 20971520(20MB)
MAX_STORED_SOURCE_BYTES=20971520


# ── 작은 저장소 RAG 우회 ──────────────────────────────────────
#
# 소스 전체가 아래 상한 안에 들어가는 저장소는 인덱싱하지 않고 코드를 통째로
# 대화에 넣는다(검색 없음). 인용 정확도가 0.75 → 1.00 으로 오른 측정이 근거다.
# 이 경로에서는 색인이 즉시 완료되어 "코드를 처음 읽는 중" 배너가 뜨지 않는다.

# 우회로 보낼 소스 번들의 토큰 상한. 0이면 우회를 끄고 항상 RAG 를 쓴다.
# "질문 1회당 입력 비용이 RAG 경로의 4배를 넘지 않을 것"에서 역산한 값이라
# 임의로 올리면 그만큼 비용이 는다. 산식은 config.py 주석에 있다. 기본값: 57000
FULL_INJECTION_MAX_TOKENS=57000

# 사전 게이트(바이트). 토큰을 세기 전에 명백히 큰 저장소를 먼저 걸러낸다.
# 토큰 상한보다 느슨하게 잡을 것 — 여기서 떨어진 저장소는 토큰을 세어 보지도
# 않으므로, 조이면 우회 대상이 조용히 사라진다. 기본값: 512000(500KB)
FULL_INJECTION_MAX_SOURCE_BYTES=512000


# ── 남용 방지 ────────────────────────────────────────────────
#
# 로그인이 없어 누구나 호출할 수 있으므로, 일일 상한은 사용자별이 아니라
# 서비스 전체(모든 사용자 합산) 기준이다. 어느 값이든 0으로 두면 그 제한이 꺼진다.
# 캐시 히트는 LLM 비용이 없어 아래 제한을 모두 소모하지 않는다.
#
# ※ 카운터는 DATABASE_URL 이 있으면 DB(rate_limit_daily / rate_limit_hits)에,
#   없으면 파일(cache/rate_limit.json)에 쌓인다.
#
#   **다중 워커로 띄울 거라면 DATABASE_URL 이 필요하다.** 파일 경로는 프로세스 안
#   Lock 으로만 보호되어, uvicorn --workers 2 이상에서는 카운터가 서로 덮어써진다.
#   실측(프로세스 5개 × 10회): 파일 3/50 · DB 50/50 — 워커가 여럿이면 파일 경로는
#   상한이 느슨해지는 정도가 아니라 거의 걸리지 않는다.
#   단일 프로세스로 띄운다면 파일 경로도 정확하다.

# 하루에 허용할 LLM 호출 횟수. 넘으면 429 + "내일 다시 시도" 안내. 기본값: 500
DAILY_LLM_CALL_LIMIT=500

# 하루에 허용할 토큰 합계(입력+출력). 호출 전에는 사용량을 알 수 없어 사후 판정이라,
# 상한을 넘기는 마지막 한 번은 통과한다. 기본값: 5000000
DAILY_TOKEN_LIMIT=5000000

# IP 하나가 아래 시간창 안에서 보낼 수 있는 요청 수. 기본값: 20
IP_RATE_LIMIT=20

# IP별 제한의 시간창(초). 기본 3600 = 1시간. 기본값: 3600
IP_RATE_WINDOW_SECONDS=3600

# 1이면 X-Forwarded-For(맨 앞) → X-Real-IP 순으로 클라이언트 IP를 읽는다.
# 이 헤더들은 클라이언트가 위조할 수 있으므로, 헤더를 덮어써 주는 프록시
# (Nginx·Cloudflare 등) 뒤에 있을 때만 켤 것. 켜지 않으면 TCP 연결 IP를 쓴다.
# 기본값: 0
TRUST_PROXY_HEADERS=0
